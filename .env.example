# PostgreSQL connection string
DATABASE_URL="postgresql://examprep:examprep@localhost:5432/examprep"

# Long random string used to sign session cookies (openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used for Stripe redirect URLs)
APP_URL="http://localhost:3000"

# Stripe billing. Leave blank in development and set DEV_FAKE_BILLING=true to
# activate subscriptions without Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
DEV_FAKE_BILLING="true"
