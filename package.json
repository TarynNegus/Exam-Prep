{
  "name": "exam-prep",
  "version": "0.1.0",
  "private": true,
  "description": "Subscription-based practice platform for Cambridge IGCSE, AS and A Level exams",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "content:import": "tsx scripts/import-content.ts",
    "postinstall": "prisma generate",
    "db:setup": "node --env-file-if-exists=.env scripts/check-db-url.mjs && prisma migrate deploy && tsx scripts/import-content.ts",
    "db:check": "node --env-file-if-exists=.env scripts/check-db-url.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "next": "15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^19.0.0",
    "zod": "3.25.76",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "3.2.7"
  }
}
